# ===== LLM (опционально — без ключа работает режим retrieval-only) =====
# Любой OpenAI-совместимый API: OpenAI, Groq, OpenRouter, Together, Ollama...
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# ===== Embedding-модель (многоязычная, русский поддерживает) =====
# Варианты: intfloat/multilingual-e5-small (быстрее) / -base (точнее) / -large (макс. качество)
EMBED_MODEL=intfloat/multilingual-e5-base

# ===== Чанкинг =====
CHUNK_SIZE=1100
CHUNK_OVERLAP=200

# ===== Поиск =====
TOP_K=4
CANDIDATES=12
RRF_K=60
SPARSE_REL_THRESHOLD=0.35
